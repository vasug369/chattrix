PORT=3000
NODE_ENV=development

# MongoDB connection string. For local dev: mongodb://127.0.0.1:27017/chattrix_dev
# For Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/chattrix_dev

# JWT — use long random strings in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too

# Email (SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_USER=<smtp_user>
SMTP_PASS=<smtp_password>
SMTP_PORT=587
SENDER_EMAIL=<your_email>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# Frontend origin(s) allowed for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
