# Copy to .env and fill in. Validated at boot by src/config/env.js —
# the server refuses to start rather than failing later with a confusing 500.

NODE_ENV=development
PORT=3000

# --- Database ---
# Either a full connection string:
# MONGO_URI=mongodb://127.0.0.1:27017/chattrix
# or the Atlas triple:
DB_Host=
DB_Pass=
DB_Name=chattrix

# --- JWT ---
# Both are REQUIRED and must be at least 16 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- CORS ---
# Comma-separated list of allowed browser origins. Compared against the
# browser's Origin header, so entries
# must be scheme://host[:port] with no trailing slash, no quotes and no path.
# Anything else silently matches nothing: the request succeeds but carries no
# CORS header and the browser blocks it, with nothing in the server log. The
# boot log prints the parsed list for exactly this reason.
CORS_ORIGINS=http://localhost:5173,https://chattrix-social.vercel.app

# --- Public frontend URL ---
# Used for links inside emails (the welcome message's "Open Chattrix" button).
# Must be the address real users visit, not localhost, or new signups receive a
# dead link.
APP_URL=https://chattrix-social.vercel.app

# --- Mail (optional) ---
#
# Two providers are supported. Resend takes priority when its key is present.
#
# Resend (recommended). Uses the HTTPS API rather than SMTP: managed hosts
# commonly filter outbound SMTP ports, which presents as an 8s connection
# timeout rather than an auth error and is easy to misdiagnose.
RESEND_API_KEY=
#
# Brevo. Verifies a single SENDER ADDRESS rather than a whole domain, so it can
# mail arbitrary recipients without owning a domain — 300/day free. New free
# accounts must have transactional sending activated by Brevo first; until then
# every send is refused with "Your SMTP account is not yet activated".
BREVO_API_KEY=
#
# Force a provider instead of auto-detecting (resend | brevo | smtp | disabled).
# Auto-detection order is brevo > resend > smtp > disabled; set this explicitly
# when more than one credential is present.
MAIL_PROVIDER=
#
# IMPORTANT: until you add and verify a domain at https://resend.com/domains,
# Resend accepts only `onboarding@resend.dev` as the sender, and will deliver
# only to the address that owns the Resend account. A personal gmail.com
# address as SENDER_EMAIL is rejected outright.
#
# SMTP is the fallback, used only when RESEND_API_KEY is empty. Note that
# `sandbox.smtp.mailtrap.io` captures mail in a web inbox and never delivers to
# a real address — useful in development, silently useless in production.
# When SMTP_USER/SMTP_PASS are unset, mail is logged instead of sent, so
# registration and OTP flows still work locally.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=no-reply@chattrix.app

# --- Cloudinary (optional) ---
# When unset, image uploads are rejected with a clear message rather than
# silently going to the wrong account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OTP policy ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- bcrypt work factor (4-15; leave unset for the default of 10) ---
# BCRYPT_ROUNDS=10
