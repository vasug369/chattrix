# Production build configuration.
#
# This file is committed on purpose. `.env` and `.env.local` are gitignored, so
# a Vercel build clones the repo, finds no environment file, and falls back to
# the localhost default in src/lib/api.js — which shipped a production bundle
# that asked every visitor's own machine for the API.
#
# Vite loads `.env.[mode]` only for that mode and it outranks `.env.local`, so
# this applies to `npm run build` and leaves `npm run dev` alone.
#
# Contains no secret: the API URL is public by definition, since the browser
# has to know it.
VITE_API_BASE_URL=https://chattrix-2.onrender.com
