# Local development. Copy to .env (which is gitignored).
#
# Production does NOT use this file: .env and .env.local are gitignored, so a
# Vercel build would never see them. The deployed API URL lives in the
# committed .env.production instead.
VITE_API_BASE_URL=http://localhost:3000

# --- Google sign-in (optional) ---
# The OAuth client ID from https://console.cloud.google.com/apis/credentials.
# Must match GOOGLE_CLIENT_ID in the backend exactly, or every sign-in fails
# the audience check.
#
# Public by design: it is baked into the bundle and visible to anyone. It is an
# identifier, not a secret — a client ID alone authorises nothing.
#
# Leave unset to hide the button; the whole Google path is then stripped from
# the build.
VITE_GOOGLE_CLIENT_ID=
